$ unikraft instance --help

stdout:
	Manage Unikraft Cloud instances.

	Usage:
	  unikraft instances <command> [flags]

	Resources:
	  get, inspect, show
	          Inspect a instance.
	  wait
	          Wait for instances to match a filter.
	  list, ls
	          List instances.
	  delete, rm, remove
	          Remove a instance.
	  create
	          Create an instance.
	  edit
	          Edit an instance.
	  logs
	          Fetch and display instance logs.
	  start
	          Start one or more instances.
	  stop
	          Stop one or more instances.
	  suspend
	          Suspend one or more instances.
	  restart
	          Restart one or more instances.

	Templates:
	  template, templates
	          Manage instance templates.

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  image
	  runtime, runtime.args, runtime.env
	  resources, resources.memory, resources.vcpus
	  service
	  volumes, volumes.*
	  networks, networks.*, networks.*.uuid, networks.*.private-ip, networks.*.mac
	  timestamps, timestamps.created, timestamps.started, timestamps.stopped
	  scale-to-zero
	  timing, timing.uptime, timing.boot-time, timing.net-time
	  restart, restart.policy, restart.start-count, restart.restart-count
	  autostart
	  replicas
	  wait-timeout
	  features
	  vsock
	  template
	  stop, stop.reason, stop.origin, stop.errno, stop.exit-code

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config=<file> ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level=<level> ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choices: trace, debug, info, warn, error, fatal]
	      --log-type=<type> ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choices: text, json]
	      --profile=<name> ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]

$ unikraft instance get --help

stdout:
	Inspect a instance.

	Usage:
	  unikraft instances get [<target> ...] [flags]

	Arguments:
	  [<target> ...]
	          Target instances to get.

	Examples:
	  # Inspect an instance by name
	  unikraft instance get demo-instance

	  # Inspect an instance by UUID
	  unikraft instance get 12345678-1234-1234-1234-123456789abc

	  # Inspect an instance in a specific metro
	  unikraft instance get fra/demo-instance

	  # Show instance details in JSON format
	  unikraft instance get demo-instance -o json

	  # Watch instance state changes in real-time
	  unikraft instance get demo-instance -w

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  image
	  runtime, runtime.args, runtime.env
	  resources, resources.memory, resources.vcpus
	  service
	  volumes, volumes.*
	  networks, networks.*, networks.*.uuid, networks.*.private-ip, networks.*.mac
	  timestamps, timestamps.created, timestamps.started, timestamps.stopped
	  scale-to-zero
	  timing, timing.uptime, timing.boot-time, timing.net-time
	  restart, restart.policy, restart.start-count, restart.restart-count
	  autostart
	  replicas
	  wait-timeout
	  features
	  vsock
	  template
	  stop, stop.reason, stop.origin, stop.errno, stop.exit-code

	Flags:
	  -w, --watch=<duration>
	          Watch for changes and refresh output. Defaults to 2s.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config=<file> ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level=<level> ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choices: trace, debug, info, warn, error, fatal]
	      --log-type=<type> ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choices: text, json]
	      --profile=<name> ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]

$ unikraft instance list --help

stdout:
	List instances.

	Usage:
	  unikraft instances list [<target> ...] [flags]

	Arguments:
	  [<target> ...]
	          Target instances to list.

	Examples:
	  # List instances across all metros
	  unikraft instance list

	  # List only running instances
	  unikraft instance list --filter 'state=="running"'

	  # List instances sorted by creation time (newest first)
	  unikraft instance list --sort -timestamps.created

	  # Watch instances and refresh every 5 seconds
	  unikraft instance list -w 5s

	  # List instances as a table with additional fields
	  unikraft instance list -f +resources -o table

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  image
	  runtime, runtime.args, runtime.env
	  resources, resources.memory, resources.vcpus
	  service
	  volumes, volumes.*
	  networks, networks.*, networks.*.uuid, networks.*.private-ip, networks.*.mac
	  timestamps, timestamps.created, timestamps.started, timestamps.stopped
	  scale-to-zero
	  timing, timing.uptime, timing.boot-time, timing.net-time
	  restart, restart.policy, restart.start-count, restart.restart-count
	  autostart
	  replicas
	  wait-timeout
	  features
	  vsock
	  template
	  stop, stop.reason, stop.origin, stop.errno, stop.exit-code

	Flags:
	      --filter
	          Filter output based on a field value.
	          [examples: name==my-instance, metro==fra]
	  -w, --watch=<duration>
	          Watch for changes and refresh output. Defaults to 2s.
	      --sort
	          Sort output by field values. Use - prefix for descending, + for ascending.
	          [examples: name, -timestamps.created-at]
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config=<file> ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level=<level> ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choices: trace, debug, info, warn, error, fatal]
	      --log-type=<type> ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choices: text, json]
	      --profile=<name> ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]

