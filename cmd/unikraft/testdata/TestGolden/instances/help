	  replicas
	  wait-timeout
	  features
	  vsock
	  template
	  stop, stop.reason, stop.origin, stop.errno, stop.exit-code

	Flags:
	      --until, --filter
	          Filter expression to wait for.
	          [examples: state==running, state!=stopped]
	      --interval
	          Polling interval.
	          [default: 2s]
	      --timeout
	          Timeout before giving up.
	          [default: 0]
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

