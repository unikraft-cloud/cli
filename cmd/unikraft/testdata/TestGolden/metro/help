$ unikraft metro list --help

stdout:
	List metros.

	Usage:
	  unikraft metros list [<target> ...] [flags]

	Arguments:
	  [<target> ...]
	          Target metros to list.

	Examples:
	  # List all metros
	  unikraft metro list

	  # List metros with connection status
	  unikraft metro list -f +status

	  # List metros with quota usage
	  unikraft metro list -f +quotas

	Fields:
	  name
	  country
	  endpoint
	  insecure
	  quotas, quotas.instances, quotas.instances.active,
	  quotas.instances.active.used, quotas.instances.active.limit,
	  quotas.instances.total, quotas.instances.total.used,
	  quotas.instances.total.limit, quotas.vcpus, quotas.vcpus.active,
