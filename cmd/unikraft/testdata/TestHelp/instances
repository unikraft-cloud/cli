Edit an instance.

Usage:
  unikraft instances edit <target> [flags]

Arguments:
  <target>
          Target instance to edit.

Examples:
  # Resize instance memory
  unikraft instance edit demo-instance --memory 256

  # Attach a ROM image to an instance
  unikraft instance edit demo-instance \
  	  --set roms=name=my-rom,image=myuser/my-rom:latest,at=/rom0

  # Add a ROM to an instance without replacing existing ones
  unikraft instance edit demo-instance \
  	  --add roms=name=mydata,dir=./mydata,at=/rom

  # Remove a ROM from an instance by name
  unikraft instance edit demo-instance --del roms=my-rom

  # Attach a volume to an instance
  unikraft instance edit demo-instance --add volumes=my-vol:/data

  # Detach a volume from an instance
  unikraft instance edit demo-instance --del volumes=my-vol

